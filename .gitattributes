# Keep build entry points executable by Linux / WSL after a Windows clone.
*.sh text eol=lf
/Makefile text eol=lf
configure text eol=lf
*.py text eol=lf
*.pl text eol=lf
*.mjs text eol=lf
/wasm-page/package-lock.json text eol=lf

# Portable repository maintenance hooks
tools/repo_maintenance_guard.py text eol=lf
tools/repo_maintenance_hooks/pre-commit text eol=lf
tools/repo_maintenance_hooks/commit-msg text eol=lf
tools/repo_maintenance_hooks/pre-push text eol=lf

# Exclude documentation site sources and generated diagram bundles from GitHub language statistics.
docs-site/** linguist-documentation=true
docs-site/public/diagrams/** linguist-generated=true
deps/** linguist-vendored=true
upstream/** linguist-vendored=true
