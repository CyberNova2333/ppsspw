# Keep resource experiments explicit and reject unsupported linker inputs before
# compiling. This file can also be included from cmake -P for validation tests.
set(WASM_INITIAL_MEMORY "536870912" CACHE STRING "Initial WebAssembly memory in bytes")
set(WASM_MAXIMUM_MEMORY "4294967296" CACHE STRING "Maximum WebAssembly memory in bytes")
set(WASM_COMPUTE_THREADS "2" CACHE STRING "WebAssembly native compute workers (I/O workers remain at least four)")
set(WASM_PTHREAD_POOL_SIZE "auto" CACHE STRING "Precreated browser workers: auto preserves hardware concurrency, or use a fixed count")

foreach(memory_option WASM_INITIAL_MEMORY WASM_MAXIMUM_MEMORY)
	if(NOT "${${memory_option}}" MATCHES "^[1-9][0-9]*$")
		message(FATAL_ERROR "${memory_option} must be a positive decimal byte count")
	endif()
	if(${memory_option} LESS 65536 OR ${memory_option} GREATER 4294967296)
		message(FATAL_ERROR "${memory_option} must be between one wasm page and 4 GiB")
	endif()
	math(EXPR memory_remainder "${${memory_option}} % 65536")
	if(NOT memory_remainder EQUAL 0)
		message(FATAL_ERROR "${memory_option} must be aligned to a 65536-byte wasm page")
	endif()
endforeach()
if(WASM_INITIAL_MEMORY GREATER WASM_MAXIMUM_MEMORY)
	message(FATAL_ERROR "WASM_INITIAL_MEMORY must not exceed WASM_MAXIMUM_MEMORY")
endif()

if(NOT WASM_COMPUTE_THREADS MATCHES "^[1-9][0-9]*$")
	message(FATAL_ERROR "WASM_COMPUTE_THREADS must be an integer from 1 to 32")
endif()
if(WASM_COMPUTE_THREADS GREATER 32)
	message(FATAL_ERROR "WASM_COMPUTE_THREADS must be an integer from 1 to 32")
endif()
set(WASM_IO_THREADS ${WASM_COMPUTE_THREADS})
if(WASM_IO_THREADS LESS 4)
	set(WASM_IO_THREADS 4)
endif()

if(WASM_PTHREAD_POOL_SIZE STREQUAL "auto")
	if(NOT WASM_COMPUTE_THREADS EQUAL 2)
		message(FATAL_ERROR "A custom WASM_COMPUTE_THREADS count requires a fixed WASM_PTHREAD_POOL_SIZE")
	endif()
	# Preserve the existing release default, including the SDK's default strictness.
	set(WASM_PTHREAD_POOL_EXPRESSION "Math.max(4,navigator.hardwareConcurrency||4)")
	set(WASM_PTHREAD_POOL_SIZE_METRIC 0)
else()
	if(NOT WASM_PTHREAD_POOL_SIZE MATCHES "^[1-9][0-9]*$")
		message(FATAL_ERROR "WASM_PTHREAD_POOL_SIZE must be auto or a positive decimal worker count")
	endif()
	# Reserve workers for recent files, emulation, loading, I/O, optional SAS,
	# and savedata. Optional subsystems may need more; fixed pools deliberately
	# fail on exhaustion instead of creating asynchronous workers and deadlocking.
	math(EXPR minimum_pool_size "${WASM_COMPUTE_THREADS} + ${WASM_IO_THREADS} + 6")
	if(WASM_PTHREAD_POOL_SIZE LESS minimum_pool_size OR WASM_PTHREAD_POOL_SIZE GREATER 128)
		message(FATAL_ERROR "WASM_PTHREAD_POOL_SIZE must be between ${minimum_pool_size} and 128 for this compute worker count")
	endif()
	set(WASM_PTHREAD_POOL_EXPRESSION ${WASM_PTHREAD_POOL_SIZE})
	set(WASM_PTHREAD_POOL_SIZE_METRIC ${WASM_PTHREAD_POOL_SIZE})
endif()
